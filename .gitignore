__pycache__/
*.pyc
*.pyo
*.egg-info/
.DS_Store

# Backtest data cache (regenerable)
.backtest_cache/

# Build/package artifacts (regenerable)
.venv-build/
.venv/
*.log
build/
dist/
*.spec
# ...but packaging/DraftAssistant.spec is hand-written and IS the build config.
!packaging/DraftAssistant.spec
# Icons are regenerated by packaging/make_icons.py at the start of every build.
packaging/icons/

# Provider credentials — secrets, never commit. Both are written into the
# secret dir, which is the checkout root in a source tree (paths.resolve()).
yahoo.json
**/yahoo.json
espn.json
**/espn.json

# Live draft state and per-league profiles — rewritten on every pick, so
# tracking them meant every draft dirtied the working tree. The player board
# (data/projections.json) stays tracked so a clone is usable immediately.
draft_state.json
workspace-state.json
workspace-state.lock
webview/
backups/
.draft_assistant_profiles/
# Dynamic injury/trend/weekly context is regenerated and never bundled.
data/player_context.json
